# XPU deployment env for pdf-to-podcast. Copy to .env and adjust:
#   cp .env.xpu.example .env
#
# Defaults below run out-of-the-box on an Intel Arc Pro host that has the
# model cached under /data/llm-models and an HF cache at /data/hf-cache
# behind the Intel proxy. On other hosts, override the marked values.

# --- LLM (served by scripts/xpu/start-vllm-xpu.sh, reached via models.json) ---
# No real NVIDIA key needed: models.json points at the local vLLM-XPU endpoint.
NVIDIA_API_KEY=local

# --- TTS (Parler-TTS) ---
MAX_CONCURRENT_REQUESTS=1
# cpu is portable and always works. Set to xpu only if the TTS image's Level
# Zero UMD matches the host GPU driver (see XPU_MIGRATION.md).
TTS_DEVICE=cpu
TTS_MODEL=parler-tts/parler-tts-mini-v1

# --- HuggingFace cache (pre-download Parler-TTS here to avoid first-run fetch) ---
# HOST path mounted into the TTS container at /data/hf-cache.
HF_CACHE_DIR=/data/hf-cache
HF_HOME=/data/hf-cache

# --- Proxy (needed for image builds + first-run model downloads on proxied hosts) ---
# Direct-internet hosts: leave these commented out (the default). On a
# proxied / air-gapped host, uncomment and set to your proxy, e.g.:
#   HTTP_PROXY=http://proxy.example.com:912
#   HTTPS_PROXY=http://proxy.example.com:912
NO_PROXY=localhost,127.0.0.1,redis
